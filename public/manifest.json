{
  "name": "Atarashii (New) Tab Page",
  "version": "0.1.10",
  "manifest_version": 3,
  "browser_specific_settings": {
    "gecko": {
      "id": "atarashii-tab@custom-fix"
    }
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "host_permissions": [
    "https://*.reddit.com/*",
    "https://*.redd.it/*"
  ]
}